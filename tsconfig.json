{
  "compilerOptions": {
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleDetection": "force",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "node",
      "vite/client",
      "unplugin-icons/types/vue"
    ],
    "useDefineForClassFields": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "tests/browser/importLab/**/*.ts",
    "tests/browser/importLab/**/*.vue",
    "tests/browser/reference/**/*.ts",
    "tests/browser/reference/**/*.vue"
  ],
  "exclude": [
    "src/native/nativeOnboardingShortcut.test.ts",
    "src/native/nativeVisibilityController.test.ts",
    "src/native/nativeContextMenu.test.ts",
    "src/rendering/native/NativeImportHelp.ts",
    "src/rendering/native/NativeLayoutRecovery.ts",
    "src/rendering/native/NativeOnboarding.ts",
    "src/rendering/native/NativeImportPlacement.ts",
    "src/rendering/native/NativeNewAppsButton.ts",
    "src/rendering/native/nativeColorPicker.ts",
    "src/rendering/native/NativeFolderNameInput.ts",
    "src/native/nativeIconRecoverySmoke.test.ts",
    "src/rendering/native/nativeDragVisualSmoke.test.ts",
    "src/rendering/native/nativeDragNavigationSmoke.test.ts",
    "src/rendering/native/nativeToolbarVisualSmoke.test.ts",
    "src/native/nativeLayoutLoad.ts",
    "src/rendering/native/NativeAppDialogs.ts",
    "src/rendering/native/NativeModalPanel.ts",
    "src/native/nativeAppsMemoryBenchmark.ts",
    "src/rendering/native/ui/nativeUiGallery.ts",
    "src/rendering/native/nativeSettingsInput.ts",
    "src/native/nativeMain.ts",
    "src/native/nativeSmokeSupport.ts",
    "src/native/nativeSearchSmoke.ts",
    "src/native/nativeCatalogPort.ts",
    "src/rendering/native/nativeAppsSettingsPage.ts",
    "src/rendering/native/NativeSearchBar.ts",
    "src/rendering/native/NativeManagement.ts",
    "src/rendering/native/NativeSpinButton.ts",
    "src/rendering/native/nativeLayoutSettingsPage.ts",
    "src/rendering/native/nativeGeneralSettingsPage.ts",
    "src/rendering/native/nativeHotCornerSettings.ts",
    "src/rendering/native/nativeBackgroundSettings.ts",
    "src/native/product/**/*.ts",
    "src/native/diagnostics/**/*.ts",
    "src/native/nativeClipboard.ts",
    "src/native/nativeLiveDesktopLibrary.ts",
    "src/native/nativeHotCornersLibrary.ts"
  ]
}
