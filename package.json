{
  "name": "lumeria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "devtools:mcp": "node vendor/electrobun-pixi-native-starter/tools/devtools-mcp.mjs",
    "devtools:cli": "node vendor/electrobun-pixi-native-starter/tools/devtools-cli.mjs",
    "benchmark:diagnostics": "node --expose-gc --import tsx scripts/benchmarkMotionDiagnostics.ts",
    "check": "npm run check:pixi-patch && npm test && npm run typecheck && npm run check:policy && npm run check:i18n && npm run build",
    "check:i18n": "tsx scripts/checkI18n.ts",
    "check:pixi-patch": "node vendor/electrobun-pixi-native-starter/tools/patch-electrobun.mjs --consumer-root . --check",
    "check:policy": "tsx scripts/checkProjectPolicy.ts",
    "dev": "vite",
    "icons:export": "tsx scripts/exportBrandIcons.ts",
    "native:data:build": "cargo build --manifest-path src-tauri/Cargo.toml --bin lumeria_native_data --release",
    "prenative:build": "npm run native:data:build",
    "native:build": "node vendor/electrobun-pixi-native-starter/consumer/run-electrobun.mjs build",
    "prenative:build:bytecode": "npm run native:data:build",
    "native:build:bytecode": "node vendor/electrobun-pixi-native-starter/consumer/run-electrobun.mjs build-bytecode",
    "prenative:dev": "npm run native:data:build",
    "native:dev": "tsx scripts/runNativeElectrobun.ts --dev",
    "prenative:smoke": "npm run native:data:build",
    "native:smoke": "tsx scripts/runNativeElectrobun.ts",
    "postinstall": "node vendor/electrobun-pixi-native-starter/tools/patch-electrobun.mjs --consumer-root .",
    "test": "tsx src/domain/runLaunchpadLayoutTests.ts && tsx scripts/checkProjectPolicyTests.ts && tsx scripts/runNativeProcess.test.ts && tsx scripts/nativeBuildDefines.test.ts && tsx src/native/scene.test.ts && tsx src/native/nativeIconTextureSource.test.ts && tsx src/native/nativeIconTextureLoader.test.ts && tsx src/native/nativeRecoverableIconSource.test.ts && tsx src/native/nativeIconResidency.test.ts && tsx src/native/persistence.test.ts",
    "test:i18n-ui": "playwright test tests/browser/i18n-search-placeholder.spec.ts --project=chromium --workers=1",
    "test:multi-select-ui": "playwright test tests/browser/launchpad-multi-select-management.spec.ts --project=chromium --workers=1",
    "test:pixi-webgl": "playwright test tests/browser/pixi-drag-preview-mask-batch.spec.ts --project=chromium --workers=1",
    "test:pixi-webgpu": "playwright test --config=playwright.webgpu.config.ts --workers=1",
    "test:trusted-mouse-ui": "playwright test tests/browser/launchpad-provisional-folder-mouse.spec.ts --project=chromium --workers=1",
    "test:trusted-mouse-webview": "playwright test tests/browser/launchpad-provisional-folder-mouse.spec.ts --config=playwright.webview.config.ts",
    "test:ui": "playwright test --project=chromium --workers=1",
    "build": "vite build",
    "typecheck": "npm run typecheck:app && npm run typecheck:tools && npm run typecheck:native",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.json",
    "typecheck:native": "tsc --noEmit -p tsconfig.electrobun.json",
    "typecheck:tools": "tsc --noEmit -p tsconfig.tools.json",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@fluentui/tokens": "^1.0.0-alpha.23",
    "@fluentui/web-components": "^3.0.0",
    "@napi-rs/canvas": "1.0.8",
    "@tanstack/vue-virtual": "^3.13.31",
    "@tauri-apps/api": "2.11.0",
    "electrobun": "2.0.1",
    "gsap": "^3.15.0",
    "pinyin-pro": "^3.28.1",
    "pixi.js": "8.20.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@iconify-json/fluent": "^1.2.51",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.0.0",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.10",
    "zod": "4.5.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "license": "GPL-3.0-only"
}
