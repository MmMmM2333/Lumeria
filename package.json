{
  "name": "lumeria",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "benchmark:diagnostics": "node --expose-gc --import tsx scripts/benchmarkMotionDiagnostics.mjs",
    "check": "npm test && npm run typecheck && npm run check:i18n && npm run build",
    "check:i18n": "node scripts/checkI18n.mjs",
    "dev": "vite",
    "icons:export": "node scripts/exportBrandIcons.mjs",
    "test": "tsx src/domain/runLaunchpadLayoutTests.js",
    "test:i18n-ui": "playwright test tests/browser/i18n-search-placeholder.spec.mjs --project=chromium --workers=1",
    "test:multi-select-ui": "playwright test tests/browser/launchpad-multi-select-management.spec.mjs --project=chromium --workers=1",
    "test:pixi-webgl": "playwright test tests/browser/pixi-drag-preview-mask-batch.spec.mjs --project=chromium --workers=1",
    "test:ui": "playwright test --project=chromium --workers=1",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@fluentui/tokens": "^1.0.0-alpha.23",
    "@fluentui/web-components": "^3.0.0",
    "@tanstack/vue-virtual": "^3.13.31",
    "@tauri-apps/api": "2.11.0",
    "gsap": "^3.15.0",
    "pinyin-pro": "^3.28.1",
    "pixi.js": "^8.18.1",
    "vue": "^3.5.0",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@iconify-json/fluent": "^1.2.51",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "license": "GPL-3.0-only"
}
