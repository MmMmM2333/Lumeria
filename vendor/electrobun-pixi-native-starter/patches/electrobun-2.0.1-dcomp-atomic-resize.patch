+// Attach (or detach) a background visual owned by an independently committed
+// composition device (the Rust GPU view's own IDCompositionVisual) into the
+// DComp visual tree this host already owns for the HWND.
+//
+// Sharing the existing host tree is what keeps the GPU surface from being
+// clipped by the full-size child HWND, and it avoids a second
+// IDCompositionTarget on the same HWND (WINDOW_ALREADY_COMPOSED).
+// DirectComposition allows a visual from one IDCompositionDevice to be a child
+// of a visual from another, so the caller keeps committing its own subtree;
+// this host only inserts/removes the child at the bottom of its root visual and
+// commits the host sequence.
+//
+// visual == nullptr detaches and is idempotent; a destroyed target yields the
+// natural terminal state where the host holds no reference.
+// Returns 1 on success, 0 for an unknown/destroyed or out-of-process HWND, and
+// -1 when a DirectComposition call failed.
+extern "C" ELECTROBUN_EXPORT int32_t wgpuWindowSetBackgroundVisual(
+    void* hwnd, void* visual) {
+    HWND targetHwnd = reinterpret_cast<HWND>(hwnd);
+    if (!targetHwnd) return 0;
+
+    // Same-process windows only; the caller is a trusted in-process peer.
+    DWORD windowProcessId = 0;
+    if (!GetWindowThreadProcessId(targetHwnd, &windowProcessId) ||
+        windowProcessId != GetCurrentProcessId() ||
+        !IsWindow(targetHwnd)) {
+        return 0;
+    }
+
+    // Take our own reference before dispatching so the visual stays valid even
+    // if the Rust side drops its reference while the main thread task is still
+    // queued.
+    ComPtr<IDCompositionVisual> incoming;
+    if (visual) incoming = static_cast<IDCompositionVisual*>(visual);
+
+    return MainThreadDispatcher::dispatch_sync([&]() -> int32_t {
+        std::shared_ptr<DCompSurfaceState> state;
+        {
+            std::lock_guard<std::mutex> mapLock(g_dcompBridgeMapMutex);
+            auto it = g_dcompSurfacesByHwnd.find(targetHwnd);
+            if (it != g_dcompSurfacesByHwnd.end()) state = it->second;
+        }
+        if (!state) return 0;
+
+        std::lock_guard<std::mutex> presentLock(state->presentMutex);
+        std::lock_guard<std::mutex> mapLock(g_dcompBridgeMapMutex);
+        auto owner = g_dcompSurfacesByHwnd.find(targetHwnd);
+        if (owner == g_dcompSurfacesByHwnd.end() || owner->second != state) {
+            return 0;
+        }
+        std::lock_guard<std::mutex> stateLock(state->mutex);
+        const HRESULT hr =
+            state->compositor.setBackgroundVisual(incoming.Get());
+        if (SUCCEEDED(hr)) return 1;
+        return hr == E_UNEXPECTED ? 0 : -1;
+    });
