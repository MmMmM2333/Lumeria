@@ -0,0 +1,175 @@
+#pragma once
+#include <directmanipulation.h>
+#include <deque>
+#include <array>
+
+// Direct Manipulation owns gesture recognition only. Pixi owns all presentation.
+// All COM operations execute on the HWND's existing UI thread; Bun only drains data.
+namespace NativeTouchpad {
+using Wake = void(*)();
+using Sample = std::array<double, 10>; // phase,time,x,y,dx,dy,modifiers,sequence,scale,error
+struct State;
+class Handler final : public IDirectManipulationViewportEventHandler {
+    std::atomic<ULONG> refs{1};
+public:
+    State* state;
+    explicit Handler(State* value):state(value){}
+    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID iid,void** out) override {
+        if(!out)return E_POINTER;*out=nullptr;
+        if(iid==__uuidof(IUnknown)||iid==__uuidof(IDirectManipulationViewportEventHandler)){
+            *out=static_cast<IDirectManipulationViewportEventHandler*>(this);AddRef();return S_OK;
+        }return E_NOINTERFACE;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override{return ++refs;}
+    ULONG STDMETHODCALLTYPE Release() override {auto value=--refs;if(!value)delete this;return value;}
+    HRESULT STDMETHODCALLTYPE OnViewportStatusChanged(IDirectManipulationViewport*,DIRECTMANIPULATION_STATUS,DIRECTMANIPULATION_STATUS) override;
+    HRESULT STDMETHODCALLTYPE OnViewportUpdated(IDirectManipulationViewport*) override{return S_OK;}
+    HRESULT STDMETHODCALLTYPE OnContentUpdated(IDirectManipulationViewport*,IDirectManipulationContent*) override;
+};
+struct State {
+    HWND hwnd;Wake wake;
+    Microsoft::WRL::ComPtr<IDirectManipulationManager> manager;
+    Microsoft::WRL::ComPtr<IDirectManipulationUpdateManager> updater;
+    Microsoft::WRL::ComPtr<IDirectManipulationViewport> viewport;
+    Microsoft::WRL::ComPtr<Handler> handler;
+    DWORD cookie=0;bool initialized=false,registered=false,closing=false,resetting=false,contact=false;
+    bool active=false,inertia=false,timer=false;unsigned sequence=0;
+    float lastX=0,lastY=0;POINT origin{};
+    std::mutex mutex;std::deque<Sample> samples;
+    std::vector<HWND> inputWindows;
+    static constexpr UINT_PTR Timer=0x50495854,Subclass=0x50495854;
+    State(HWND h,Wake w):hwnd(h),wake(w){}
+    void emit(int phase,double dx=0,double dy=0,double scale=1,HRESULT error=S_OK){
+        if(closing)return;
+        const unsigned mods=((GetKeyState(VK_SHIFT)&0x8000)?1:0)|((GetKeyState(VK_CONTROL)&0x8000)?2:0)|((GetKeyState(VK_MENU)&0x8000)?4:0);
+        {std::lock_guard<std::mutex> guard(mutex);
+         if(samples.size()>=4096){samples.clear();phase=5;dx=dy=0;error=HRESULT_FROM_WIN32(ERROR_BUFFER_OVERFLOW);}
+         samples.push_back({double(phase),double(GetTickCount64()),double(origin.x),double(origin.y),dx,dy,double(mods),double(sequence),scale,double(error)});}
+        if(wake)wake();
+    }
+    void stopTimer(){if(timer){KillTimer(hwnd,Timer);timer=false;}}
+    void cancel(){
+        if(active||inertia||contact)emit(5);
+        active=inertia=contact=false;resetting=true;
+        if(viewport)viewport->Stop();
+        stopTimer();resetting=false;
+    }
+    void reset(){
+        // Each RUNNING phase snapshots the current transform. Re-centering is
+        // unnecessary for an unbounded translation viewport and can synthesize
+        // a second RUNNING phase mistaken for a user's new gesture.
+        lastX=lastY=0;
+    }
+    void close(){
+        if(closing)return;cancel();closing=true;
+        if(handler)handler->state=nullptr;
+        if(viewport){viewport->Disable();if(registered)viewport->RemoveEventHandler(cookie);viewport->Abandon();}
+        if(manager)manager->Deactivate(hwnd);
+        for(HWND input:inputWindows)if(IsWindow(input))RemoveWindowSubclass(input,proc,Subclass);
+        inputWindows.clear();
+        handler.Reset();viewport.Reset();updater.Reset();manager.Reset();
+        if(initialized)CoUninitialize();
+    }
+    HRESULT start(){
+        HRESULT hr=CoInitializeEx(nullptr,COINIT_APARTMENTTHREADED);initialized=SUCCEEDED(hr);
+        if(FAILED(hr)&&hr!=RPC_E_CHANGED_MODE)return hr;
+        hr=CoCreateInstance(CLSID_DirectManipulationManager,nullptr,CLSCTX_INPROC_SERVER,IID_PPV_ARGS(&manager));if(FAILED(hr))return hr;
+        hr=manager->GetUpdateManager(IID_PPV_ARGS(&updater));if(FAILED(hr))return hr;
+        hr=manager->CreateViewport(nullptr,hwnd,IID_PPV_ARGS(&viewport));if(FAILED(hr))return hr;
+        auto config=DIRECTMANIPULATION_CONFIGURATION(DIRECTMANIPULATION_CONFIGURATION_INTERACTION|DIRECTMANIPULATION_CONFIGURATION_TRANSLATION_X|DIRECTMANIPULATION_CONFIGURATION_TRANSLATION_Y|DIRECTMANIPULATION_CONFIGURATION_TRANSLATION_INERTIA);
+        hr=viewport->ActivateConfiguration(config);if(FAILED(hr))return hr;
+        hr=viewport->SetViewportOptions(DIRECTMANIPULATION_VIEWPORT_OPTIONS_MANUALUPDATE);if(FAILED(hr))return hr;
+        handler.Attach(new Handler(this));hr=viewport->AddEventHandler(hwnd,handler.Get(),&cookie);if(FAILED(hr))return hr;registered=true;
+        RECT rect{};if(!GetClientRect(hwnd,&rect))return HRESULT_FROM_WIN32(GetLastError());
+        hr=viewport->SetViewportRect(&rect);if(FAILED(hr))return hr;
+        hr=manager->Activate(hwnd);if(FAILED(hr))return hr;
+        hr=viewport->Enable();if(FAILED(hr))return hr;
+        if(!SetWindowSubclass(hwnd,proc,Subclass,reinterpret_cast<DWORD_PTR>(this)))return E_FAIL;
+        inputWindows.push_back(hwnd);
+        EnumChildWindows(hwnd,[](HWND child,LPARAM value)->BOOL{
+            auto* s=reinterpret_cast<State*>(value);
+            if(SetWindowSubclass(child,proc,Subclass,reinterpret_cast<DWORD_PTR>(s)))s->inputWindows.push_back(child);
+            return TRUE;
+        },reinterpret_cast<LPARAM>(this));
+        for(HWND parent=GetParent(hwnd);parent;parent=GetParent(parent)){
+            if(SetWindowSubclass(parent,proc,Subclass,reinterpret_cast<DWORD_PTR>(this)))inputWindows.push_back(parent);
+        }
+        return updater->Update(nullptr);
+    }
+    static LRESULT CALLBACK proc(HWND h,UINT msg,WPARAM wp,LPARAM lp,UINT_PTR,DWORD_PTR data){
+        auto* s=reinterpret_cast<State*>(data);
+        if(!s||s->closing)return DefSubclassProc(h,msg,wp,lp);
+        if(msg==DM_POINTERHITTEST){
+            POINTER_INPUT_TYPE type{};UINT id=GET_POINTERID_WPARAM(wp);
+            if(GetPointerType(id,&type)&&type==PT_TOUCHPAD){
+                if(!s->active){GetCursorPos(&s->origin);ScreenToClient(s->hwnd,&s->origin);}
+                HRESULT hr=s->viewport->SetContact(id);
+                if(SUCCEEDED(hr)){
+                    s->contact=true;
+                    if(!s->timer)s->timer=SetTimer(s->hwnd,Timer,8,nullptr)!=0;
+                    if(!s->timer){s->emit(5,0,0,1,E_FAIL);s->cancel();}
+                    else s->updater->Update(nullptr);
+                    return 0; // SetContact claims this gesture; no parallel compatibility wheel.
+                }
+                s->emit(5,0,0,1,hr);
+            }
+        }else if(msg==WM_TIMER&&wp==Timer){
+            HRESULT hr=s->updater->Update(nullptr);if(FAILED(hr)){s->emit(5,0,0,1,hr);s->cancel();}return 0;
+        }else if(msg==WM_SIZE&&h==s->hwnd){
+            s->cancel();s->reset();RECT rect{};if(GetClientRect(h,&rect)&&rect.right>0&&rect.bottom>0)s->viewport->SetViewportRect(&rect);
+        }else if((msg==WM_KILLFOCUS&&GetAncestor(reinterpret_cast<HWND>(wp),GA_ROOT)!=GetAncestor(s->hwnd,GA_ROOT))||(msg==WM_SHOWWINDOW&&!wp)){
+            s->cancel();s->reset();
+        }else if(msg==WM_NCDESTROY){if(h==s->hwnd)s->close();else RemoveWindowSubclass(h,proc,Subclass);}
+        return DefSubclassProc(h,msg,wp,lp);
+    }
+};
+HRESULT Handler::OnViewportStatusChanged(IDirectManipulationViewport*,DIRECTMANIPULATION_STATUS current,DIRECTMANIPULATION_STATUS previous){
+    auto* s=state;if(!s||s->closing||s->resetting)return S_OK;
+    if(current==DIRECTMANIPULATION_RUNNING){
+        if(s->inertia)s->emit(5);
+        s->active=true;s->inertia=false;s->sequence++;
+        Microsoft::WRL::ComPtr<IDirectManipulationContent> content;float transform[6]{};
+        if(SUCCEEDED(s->viewport->GetPrimaryContent(IID_PPV_ARGS(&content)))&&SUCCEEDED(content->GetContentTransform(transform,6))){s->lastX=transform[4];s->lastY=transform[5];}
+        s->emit(1);
+    }else if(current==DIRECTMANIPULATION_INERTIA){
+        s->active=false;s->inertia=true;s->emit(3);
+    }else if(current==DIRECTMANIPULATION_READY){
+        if(s->active||s->inertia||s->contact)s->emit(4);
+        s->active=s->inertia=s->contact=false;s->stopTimer();s->reset();
+    }else if(previous==DIRECTMANIPULATION_RUNNING||previous==DIRECTMANIPULATION_INERTIA){s->cancel();}
+    return S_OK;
+}
+HRESULT Handler::OnContentUpdated(IDirectManipulationViewport*,IDirectManipulationContent* content){
+    auto* s=state;if(!s||s->closing||s->resetting||(!s->active&&!s->inertia))return S_OK;
+    float t[6]{};HRESULT hr=content->GetContentTransform(t,6);if(FAILED(hr)){s->emit(5,0,0,1,hr);return hr;}
+    const double dx=-(t[4]-s->lastX),dy=-(t[5]-s->lastY);s->lastX=t[4];s->lastY=t[5];
+    if(std::isfinite(dx)&&std::isfinite(dy)&&(dx!=0||dy!=0))s->emit(s->inertia?3:2,dx,dy,t[0]);return S_OK;
+}
+static std::mutex statesMutex;
+static std::map<HWND,std::shared_ptr<State>> states;
+}
+extern "C" ELECTROBUN_EXPORT int nativeTouchpadAbi(){return 1;}
+extern "C" ELECTROBUN_EXPORT int nativeTouchpadAttach(void* handle,void* wake){
+    HWND h=static_cast<HWND>(handle);DWORD pid=0;
+    if(!IsWindow(h)||!GetWindowThreadProcessId(h,&pid)||pid!=GetCurrentProcessId())return E_INVALIDARG;
+    return MainThreadDispatcher::dispatch_sync([=]()->int{
+        {std::lock_guard<std::mutex> guard(NativeTouchpad::statesMutex);if(NativeTouchpad::states.count(h))return E_UNEXPECTED;}
+        auto state=std::make_shared<NativeTouchpad::State>(h,reinterpret_cast<NativeTouchpad::Wake>(wake));
+        HRESULT hr=state->start();if(FAILED(hr)){state->close();return hr;}
+        std::lock_guard<std::mutex> guard(NativeTouchpad::statesMutex);NativeTouchpad::states[h]=state;return S_OK;
+    });
+}
+extern "C" ELECTROBUN_EXPORT int nativeTouchpadPoll(void* handle,double* output){
+    if(!output)return E_POINTER;
+    std::shared_ptr<NativeTouchpad::State> state;
+    {std::lock_guard<std::mutex> guard(NativeTouchpad::statesMutex);auto it=NativeTouchpad::states.find(static_cast<HWND>(handle));if(it==NativeTouchpad::states.end())return 0;state=it->second;}
+    std::lock_guard<std::mutex> guard(state->mutex);if(state->samples.empty())return 0;
+    std::copy(state->samples.front().begin(),state->samples.front().end(),output);state->samples.pop_front();return 1;
+}
+extern "C" ELECTROBUN_EXPORT void nativeTouchpadDetach(void* handle){
+    MainThreadDispatcher::dispatch_sync([=](){
+        std::shared_ptr<NativeTouchpad::State> state;
+        {std::lock_guard<std::mutex> guard(NativeTouchpad::statesMutex);auto it=NativeTouchpad::states.find(static_cast<HWND>(handle));if(it==NativeTouchpad::states.end())return;state=it->second;NativeTouchpad::states.erase(it);}
+        state->close();
+    });
+}
