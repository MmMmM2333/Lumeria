index 0000000..e865e14
--- /dev/null
+++ b/package/src/native/win/native_tray.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <Windows.h>
+#include <shellapi.h>
+
+namespace electrobun {
+constexpr UINT_PTR kTrayRecoveryTimerId = 1;
+constexpr UINT kTrayRecoveryIntervalMs = 1000;
+
+enum class TrayRestoreResult { restored, retryScheduled, retryUnavailable };
+
+// A DPI notification can arrive while the icon still exists; modify that entry
+// if adding it fails. Keep retries on the owning UI thread until the shell is ready.
+inline TrayRestoreResult restoreTrayIcon(HWND window, NOTIFYICONDATAW& icon) {
+    if (Shell_NotifyIconW(NIM_ADD, &icon) ||
+        Shell_NotifyIconW(NIM_MODIFY, &icon)) {
+        KillTimer(window, kTrayRecoveryTimerId);
+        return TrayRestoreResult::restored;
+    }
+    return SetTimer(window, kTrayRecoveryTimerId, kTrayRecoveryIntervalMs, nullptr)
+        ? TrayRestoreResult::retryScheduled : TrayRestoreResult::retryUnavailable;
+}
+} // namespace electrobun
